<!--
  A Chroma lexer for a subset of TLA+ and PlusCal.
-->
<lexer>
  <config>
    <name>TLA+</name>
    <alias>tla</alias>
    <filename>*.tla</filename>
  </config>
  <rules>
    <state name="root">
      <rule pattern="\(\*"><token type="CommentMultiline"/><push state="comment"/></rule>
      <rule pattern="\\\*.*$"><token type="CommentSingle"/></rule>
      <rule pattern="&#34;"><token type="LiteralStringDouble"/><push state="string"/></rule>

      <!-- `Foo == ...` defines an operator; `Lbl:` names a PlusCal step. -->
      <rule pattern="^(\s*)([A-Za-z_][A-Za-z0-9_]*)(\s*)(==)"><bygroups><token type="TextWhitespace"/><token type="NameFunction"/><token type="TextWhitespace"/><token type="OperatorWord"/></bygroups></rule>
      <rule pattern="^(\s*)([A-Za-z_][A-Za-z0-9_]*)(\s*)(:=)"><bygroups><token type="TextWhitespace"/><token type="Name"/><token type="TextWhitespace"/><token type="Operator"/></bygroups></rule>
      <rule pattern="^(\s*)([A-Za-z_][A-Za-z0-9_]*)(\s*)(:)"><bygroups><token type="TextWhitespace"/><token type="NameLabel"/><token type="TextWhitespace"/><token type="Punctuation"/></bygroups></rule>

      <rule pattern="\b(MODULE|EXTENDS|CONSTANTS?|VARIABLES?|ASSUME|ASSUMPTION|AXIOM|THEOREM|PROOF|LOCAL|INSTANCE|WITH|LET|IN|IF|THEN|ELSE|CASE|OTHER|CHOOSE|DOMAIN|ENABLED|UNCHANGED|SUBSET|UNION|EXCEPT|RECURSIVE|WF_|SF_)\b"><token type="Keyword"/></rule>
      <rule pattern="\b(BOOLEAN|STRING|Nat|Int|Real|Seq)\b"><token type="KeywordType"/></rule>
      <rule pattern="\b(TRUE|FALSE|defaultInitValue)\b"><token type="KeywordConstant"/></rule>
      <rule pattern="\b(algorithm|variables|variable|process|processes|procedure|define|macro|begin|end|while|do|if|then|else|elsif|either|or|with|await|when|assert|skip|print|return|call|goto|fair)\b"><token type="Keyword"/></rule>
      <rule pattern="\bself\b"><token type="NameBuiltinPseudo"/></rule>

      <rule pattern="([A-Za-z_][A-Za-z0-9_]*)(\()"><bygroups><token type="NameFunction"/><token type="Punctuation"/></bygroups></rule>

      <!-- Placeholder in an abridged snippet; keep the `..` range operator off it. -->
      <rule pattern="\.\.\."><token type="Text"/></rule>

      <rule pattern="/\\|\\/"><token type="Operator"/></rule>
      <rule pattern="\\(AA|EE|A|E|in|notin|subseteq|subset|supseteq|supset|cup|cap|union|intersect|times|X|o|div|mod|leq|geq|neq|neg|land|lor|lnot|equiv|prec|succ|ll|gg|cdot|le|ge)\b"><token type="Operator"/></rule>
      <rule pattern="\|-&gt;|&lt;=&gt;|==&gt;|~&gt;|=&gt;|==|:=|/=|&lt;=|&gt;=|\.\.|-&gt;|&lt;-|#|~|&lt;|&gt;|=|\+|-|\*|\^|&#39;"><token type="Operator"/></rule>

      <rule pattern="\b\d+\b"><token type="LiteralNumber"/></rule>
      <rule pattern="[A-Za-z_][A-Za-z0-9_]*"><token type="Name"/></rule>
      <rule pattern="[\[\](){},;]"><token type="Punctuation"/></rule>
      <!-- Newlines are matched on their own so the lexer comes to rest at the
           start of each line; a rule that swallowed "\n" plus the indent would
           stop the ^-anchored definition and label rules above from ever
           matching on an indented line. -->
      <rule pattern="\n"><token type="TextWhitespace"/></rule>
      <rule pattern="[^\S\n]+"><token type="TextWhitespace"/></rule>
      <rule pattern="."><token type="Text"/></rule>
    </state>

    <!-- TLA+ block comments nest, so `(*` recurses into this same state. -->
    <state name="comment">
      <rule pattern="\(\*"><token type="CommentMultiline"/><push/></rule>
      <rule pattern="\*\)"><token type="CommentMultiline"/><pop depth="1"/></rule>
      <rule pattern="[^*(]+"><token type="CommentMultiline"/></rule>
      <rule pattern="[*(]"><token type="CommentMultiline"/></rule>
    </state>

    <state name="string">
      <rule pattern="\\."><token type="LiteralStringEscape"/></rule>
      <rule pattern="&#34;"><token type="LiteralStringDouble"/><pop depth="1"/></rule>
      <rule pattern="[^&#34;\\]+"><token type="LiteralStringDouble"/></rule>
    </state>
  </rules>
</lexer>
